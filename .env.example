# ============================================================================
# Git-Voice environment configuration
# The server runs end-to-end with ZERO keys configured: every external
# integration degrades to a documented local fallback. Adding a key upgrades
# that stage of the pipeline automatically — no code changes.
# ============================================================================

# --- Server ---------------------------------------------------------------
# Render web services inject PORT automatically (default 10000).
PORT=10000
NODE_ENV=production

# Public base URL of this deployment. Used to render the widget install
# snippet in the dashboard. e.g. https://git-voice.onrender.com
APP_BASE_URL=http://localhost:10000

# Optional: when set, dashboard mutation routes (create project, reindex)
# require `Authorization: Bearer <token>`. Leave empty for a public demo.
DASHBOARD_TOKEN=

# Local persistence directory for issue audio + record snapshots.
# Leave empty to keep everything in memory (Render disks are ephemeral).
DATA_DIR=

# --- Language model (issue drafting + audio transcription + embeddings) ----
# Create a free API key (no credit card) at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Model used to draft the structured issue. Any instruct model served by the
# Gemini API works; swap the id via this var if a model is renamed/retired.
GEMMA_MODEL_ID=gemma-3-27b-it

# Model used to transcribe the recorded audio server-side when the browser
# could not transcribe it locally. Must support audio input.
TRANSCRIBE_MODEL_ID=gemini-2.5-flash

# Embedding model + dimension for the architecture index.
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIM=768

# --- Database (optional, pgvector) ------------------------------------------
# PostgreSQL connection string with the pgvector extension available
# (e.g. Neon free tier or Tiger Data). When unset, the architecture index and
# issue records run fully in memory with a JSON snapshot when DATA_DIR is set.
DATABASE_URL=

# --- Speech synthesis (optional) --------------------------------------------
# When set, the spoken client confirmation is rendered server-side with
# ElevenLabs and streamed back as audio. When unset, the widget speaks the
# confirmation with the browser-native Web Speech API (always free).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# --- GitHub issue publishing -------------------------------------------------
# Fine-grained personal access token with "Issues: Read and write" permission
# on the target repository. When unset, issues are kept as dashboard drafts.
GITHUB_TOKEN=

# Default repository for issues filed without a project-level repo override,
# as "owner/repo". Leave empty to keep every issue as a dashboard draft.
GITHUB_DEFAULT_REPO=

# Secret used to verify the "push" webhook that triggers reindexing
# (openssl rand -hex 32). Leave empty to disable the webhook endpoint.
GITHUB_WEBHOOK_SECRET=

# --- GitHub login (optional, free OAuth App) ----------------------------------
# Lets developers log in with GitHub so their private repos work per-user.
# Logged-out visitors keep full access to public repos — nothing else changes.
# 1. GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# 2. Homepage URL:      your APP_BASE_URL (e.g. https://git-voice-sh7k.onrender.com)
#    Authorization callback URL: <APP_BASE_URL>/api/auth/github/callback
# 3. Copy the Client ID + generate a Client secret, set them below.
# Requested scope is `repo` (needed to read private repos + file issues).
# Until both are set, /api/auth/* returns "not configured" and the PAT flow
# (GITHUB_TOKEN + per-project repo field) keeps working unchanged.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
