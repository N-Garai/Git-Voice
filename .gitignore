# dependencies & build output
node_modules/
dist/
dist-widget/
*.tsbuildinfo
.tmp/

# environment & secrets
.env
.env.local
.env*.local

# local runtime data (issue audio, snapshots) — root folder only.
# NOTE: anchored with leading slash so src/frontend/src/data/ (pricing tiers)
# stays tracked. Bare `data/` would shadow it on Linux/Docker and break the build.
/data/

# logs
*.log
npm-debug.log*

# editor
.vscode/
.idea/
.DS_Store
Thumbs.db

# internal working folders (not part of the published project)
.agent/
roadmap/
.freebuff/
